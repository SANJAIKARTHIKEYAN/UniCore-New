# ==========================================================
# UniCore Environment Configuration Template (.env.example)
# Copy this file to .env and customize values for your local environment
# ==========================================================

# Database Configuration (MySQL 8.0+)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/unicore_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=

# Security & Authentication (JWT 256-bit secret)
JWT_SECRET=unicore_production_jwt_secret_key_minimum_256_bits_length_for_hmac_sha256

# Server Port
PORT=8080

# Machine Learning Bridge Runtime
PYTHON_PATH=python
ML_MODEL_DIR=../ML/models
ML_TIMEOUT_SECONDS=30

# AI Academic Advisor (Optional - leave empty for built-in deterministic rule engine)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
